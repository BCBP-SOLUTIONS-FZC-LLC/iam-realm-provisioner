# Schemas must be reviewed by both the IAM team and the platform team.
api/asyncapi.yaml @BCBP-SOLUTIONS-FZC-LLC/iam-team @BCBP-SOLUTIONS-FZC-LLC/platform-team
internal/eventschema/ @BCBP-SOLUTIONS-FZC-LLC/iam-team @BCBP-SOLUTIONS-FZC-LLC/platform-team

# Domain model — entities, value objects, domain errors, and event payloads.
# Structural changes here ripple through every layer.
internal/core/domain/ @BCBP-SOLUTIONS-FZC-LLC/iam-team

# RP-INV-1 (single Keycloak writer) — this is the ONLY package permitted to
# import Nerzal/gocloak (enforced in CI by .github/scripts/arch-lint.sh).
# Any PR touching it needs platform-team eyes on the Keycloak Admin API
# contract as well as IAM review.
internal/adapter/outbound/keycloak/ @BCBP-SOLUTIONS-FZC-LLC/iam-team @BCBP-SOLUTIONS-FZC-LLC/platform-team

# OpenBao secret paths — the sole home of SAML/OIDC IdP secret material
