version: 2

# Grants Dependabot access to the private github.com/BCBP-SOLUTIONS-FZC-LLC/*
# Go modules (platform-events, platform-gincommon, platform-pgcommon). Without
# this, Dependabot cannot resolve the full module graph for ANY gomod update
# (even unrelated public deps), failing with git_dependencies_not_reachable.
#
# Requires a Dependabot secret named GO_PRIVATE_TOKEN — a PAT (classic or
# fine-grained) with read access to BCBP-SOLUTIONS-FZC-LLC private repos.
# Set it under Settings → Secrets and variables → Dependabot (NOT Actions —
# these are separate secret stores even when reusing the same name/value).
registries:
  github-bcbp:
    type: git
    url: https://github.com
    username: x-access-token
    password: ${{ secrets.GO_PRIVATE_TOKEN }}

# Dependabot version updates are temporarily paused (open-pull-requests-limit:
# 0 on every ecosystem below) at the repo owner's request. This stops new
# update PRs from being opened without losing the registries/schedule/label
# config. To re-enable, restore each limit to its prior value (gomod: 5,
# docker: 3, github-actions: 5) and remove this comment.
updates:
  - package-ecosystem: gomod
    directory: /
    registries:
      - github-bcbp
    schedule:
      interval: weekly
    open-pull-requests-limit: 0
    labels: [dependencies, go]

  - package-ecosystem: docker
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 0
    labels: [dependencies, docker]

  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 0
    labels: [dependencies, github-actions]
