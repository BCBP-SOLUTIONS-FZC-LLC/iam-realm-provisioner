{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TenantRealmReadyPayload",
  "type": "object",
  "required": [
    "tenant_id",
    "realm",
    "keycloak_shard",
    "oidc_clients"
  ],
  "additionalProperties": true,
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "realm": {
      "type": "string"
    },
    "keycloak_shard": {
      "type": "string"
    },
    "oidc_clients": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
