{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DirectPaidSignupPayload",
  "type": "object",
  "required": [
    "tenant_id",
    "realm",
    "plan",
    "direct_signup"
  ],
  "additionalProperties": true,
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "realm": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "starter",
        "pro",
        "enterprise"
      ]
    },
    "direct_signup": {
      "type": "boolean",
      "const": true
    }
  }
}
