{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TenantOffboardedPayload",
  "type": "object",
  "required": [
    "tenant_id",
    "realm",
    "export_s3_key",
    "offboarded_at"
  ],
  "additionalProperties": true,
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "realm": {
      "type": "string"
    },
    "export_s3_key": {
      "type": "string"
    },
    "offboarded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
