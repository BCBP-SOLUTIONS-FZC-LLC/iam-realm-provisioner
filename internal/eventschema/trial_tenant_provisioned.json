{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrialTenantProvisionedPayload",
  "type": "object",
  "required": [
    "tenant_id",
    "realm",
    "keycloak_user_id"
  ],
  "additionalProperties": true,
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "realm": {
      "type": "string",
      "const": "trial"
    },
    "keycloak_user_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
