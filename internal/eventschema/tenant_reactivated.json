    "tenant_id",
    "realm",
    "source"
  ],
  "additionalProperties": true,
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "realm": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "operator"
      ]
    },
    "reason": {
      "type": "string"
    }
  }
}
