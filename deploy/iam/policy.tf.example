# Terraform snippet — attach the reference policy in deploy/iam/policy.json to
# an IRSA role. This file is *illustrative*, not applied by the application.
# Platform Terraform owns the authoritative version of this resource.
#
# The SAME role must be assumable by both cmd/server (publishes to
# iam-tenant-events, consumes membership-realm-q/tenant-realm-q/
# billing-realm-q, writes realm exports to S3) and every cmd/reconciler
# CronJob (§13.1) — one ServiceAccount, one role, shared by the Deployment
# and all six CronJobs (see deploy/helm/iam-realm-provisioner's
# serviceAccount.annotations and templates/cronjobs.yaml, which all
# reference the same serviceAccountName helper).

# 1. Trust policy — the ServiceAccount `iam-realm-provisioner` in namespace
#    `iam` assumes this role via IRSA.
data "aws_iam_policy_document" "iam_realm_provisioner_trust" {
  statement {
    actions = ["sts:AssumeRoleWithWebIdentity"]
    principals {
      type        = "Federated"
      identifiers = [aws_iam_openid_connect_provider.eks.arn]
    }
    condition {
      test     = "StringEquals"
      variable = "${replace(aws_iam_openid_connect_provider.eks.url, "https://", "")}:sub"
      values   = ["system:serviceaccount:iam:iam-realm-provisioner"]
    }
    condition {
      test     = "StringEquals"
      variable = "${replace(aws_iam_openid_connect_provider.eks.url, "https://", "")}:aud"
      values   = ["sts.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "iam_realm_provisioner" {
  name               = "iam-realm-provisioner"
  assume_role_policy = data.aws_iam_policy_document.iam_realm_provisioner_trust.json
}

# 2. Permission policy — templated from deploy/iam/policy.json.
resource "aws_iam_policy" "iam_realm_provisioner" {
  name = "iam-realm-provisioner"
  policy = templatefile("${path.module}/policy.json", {
    tenant_events_topic_arn    = aws_sns_topic.iam_tenant_events.arn
    membership_realm_queue_arn = aws_sqs_queue.membership_realm.arn
    tenant_realm_queue_arn     = aws_sqs_queue.tenant_realm.arn
    billing_realm_queue_arn    = aws_sqs_queue.billing_realm.arn
    membership_realm_dlq_arn   = aws_sqs_queue.membership_realm_dlq.arn
    tenant_realm_dlq_arn       = aws_sqs_queue.tenant_realm_dlq.arn
    billing_realm_dlq_arn      = aws_sqs_queue.billing_realm_dlq.arn
    glue_registry_arn          = aws_glue_registry.iam_tenant_events.arn
    realm_export_bucket_arn    = aws_s3_bucket.iam_realm_exports.arn
    realm_export_kms_key_arn   = aws_kms_key.iam_realm_export.arn
    aws_region                 = data.aws_region.current.name
    aws_account_id             = data.aws_caller_identity.current.account_id
  })
}

resource "aws_iam_role_policy_attachment" "iam_realm_provisioner" {
  role       = aws_iam_role.iam_realm_provisioner.name
  policy_arn = aws_iam_policy.iam_realm_provisioner.arn
}
