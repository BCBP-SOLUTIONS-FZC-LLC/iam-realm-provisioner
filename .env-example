# Realm Provisioner Service — local development environment (§12).
# Copy to .env (`make setup`) and adjust as needed.

# APP_ENV is also the metrics environment label: local|dev|test|staging|prod only.
APP_ENV=dev
APP_NAME=iam-realm-provisioner
# Platform Observability Registry domain (the domain label on every metric).
OBSERVABILITY_DOMAIN=iam
APP_PORT=8080
METRICS_PORT=9090
# platform-gincommon logger (all binaries): debug|info|warn|error; dev defaults to debug.
LOG_LEVEL=debug
LOG_SAMPLING=false

# ── Postgres (platform-pgcommon) ─────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5544
PG_USER=realm_provisioner_app
PG_PASSWORD=realm_provisioner_app_dev_password
PG_DBNAME=provisioner
PG_SSLMODE=disable
PG_MAX_CONNS=10
PG_BOUNCER_MODE=false
PG_STATEMENT_TIMEOUT=5s
PG_LOCK_TIMEOUT=2s
PG_SLOW_QUERY_THRESHOLD=200ms
# SYSTEM_DATABASE_URL — the BYPASSRLS cross-tenant pool (reconciler jobs,
# §10.1). Required in dev too: realm_provisioner_app has no CREATE on
# schema public, and RP-C1..C4 need to read across every tenant.
SYSTEM_DATABASE_URL=postgres://realm_provisioner_migrator:realm_provisioner_migrator_dev_password@localhost:5544/provisioner?sslmode=disable
# MIGRATION_DATABASE_URL — required even outside PG_BOUNCER_MODE, since
# realm_provisioner_app (the DSN built from PG_USER above) has no CREATE
# grant on schema public; only realm_provisioner_migrator can run
# outbox.ApplySchema / the domain migration.
MIGRATION_DATABASE_URL=postgres://realm_provisioner_migrator:realm_provisioner_migrator_dev_password@localhost:5544/provisioner?sslmode=disable

# ── AWS / Floci (SNS, SQS, Glue, S3) ──────────────────────────────────────
# Floci — open-source, always-free LocalStack-compatible emulator
# (docker-compose.yml's `floci` service) — deterministically provisions
# these at a fixed account id (000000000000) and region, so the values
# below are real working defaults, not placeholders to fill in by hand.
# Leave any of them unset to fall back to NoopCodec (events queue in the
# outbox but are never published).
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4572
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SNS_TOPIC_TENANT_ARN=arn:aws:sns:ap-south-1:000000000000:iam-tenant-events
GLUE_REGISTRY_TENANT_NAME=iam-tenant-events
SQS_MEMBERSHIP_REALM_QUEUE_URL=http://localhost:4572/000000000000/membership-realm-q
SQS_TENANT_REALM_QUEUE_URL=http://localhost:4572/000000000000/tenant-realm-q
SQS_BILLING_REALM_QUEUE_URL=http://localhost:4572/000000000000/billing-realm-q
# Per-queue SQS consumer concurrency (platform-events WithConcurrency).
SQS_MEMBERSHIP_REALM_CONCURRENCY=4
SQS_TENANT_REALM_CONCURRENCY=4
SQS_BILLING_REALM_CONCURRENCY=2
# Shared consumer tuning for all three queues (platform-events eventcfg.LoadSQS;
# internal/adapter/inbound/sqspipeline uses the same values as defaults).
# SQS_MAX_RECEIVE_COUNT must stay below the queues' RedrivePolicy
# maxReceiveCount=5 (scripts/init-floci.sh) so platform-events forwards to the
# DLQ itself; the handler timeout must stay below the visibility timeout.
SQS_MAX_RECEIVE_COUNT=4
SQS_VISIBILITY_TIMEOUT=30s
SQS_HANDLER_TIMEOUT=20s
SQS_DRAIN_TIMEOUT=15s
SQS_QUEUE_DEPTH_INTERVAL=60s

# Schema governance (make schema-*, .github/workflows/schema-*.yml) — the
# platform-schemagov CLI, pulled as a Docker image. Used by make schema-pull,
# extract-schemas, schema-validate, schema-diff, schema-register, schema-verify,
# schema-prune. GLUE_REGISTRY_TENANT_NAME above is the shared registry these
# targets act on (shared with iam-org-membership — see LLD §7.3.1).
SCHEMA_GOV_IMAGE=ghcr.io/bcbp-solutions-fzc-llc/platform-schemagov:0.4

# PROMETHEUS_URL — event-usage data source for schema-registry.yml's
# usage-check/enforce-lifecycle steps (auto-deprecate/retire a schema with no
# observed publish activity). Deliberately left UNSET: this service is
# pre-production (nothing deployed yet, no live Prometheus) and its 9 events
# were frozen at LLD v1.0 sign-off — they must never be auto-deprecated just
# because a pre-production environment has never published them. Leaving this
# unset makes usage-check run with --source disabled, which makes
# enforce-lifecycle a deliberate no-op (not a deleted capability) until a real
# production Prometheus is wired up.
PROMETHEUS_URL=

OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_DRAIN_TIMEOUT=30s
OUTBOX_PUBLISH_CONCURRENCY=4
OUTBOX_PUBLISH_TIMEOUT=10s
OUTBOX_STARTUP_JITTER=2s
OUTBOX_CLAIM_LEASE_DURATION=10m
OUTBOX_RETENTION_DAYS=8
PROCESSED_EVENTS_TTL_DAYS=8
# ledger-prune retention (provisioning_operations, rls_violation_log).
PROVISIONING_OPERATIONS_TTL_DAYS=30
RLS_VIOLATION_LOG_TTL_DAYS=90

# ── Keycloak (RP-INV-1 — the sole seam) ──────────────────────────────────
KEYCLOAK_BASE_URL=http://localhost:8091
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=iam-realm-provisioner
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-secret-change-me
KEYCLOAK_RATE_LIMIT_RPS=20
KEYCLOAK_TIMEOUT_MS=8s
SHARED_TRIAL_REALM=trial
REALM_TEMPLATE_VERSION=v1
# REALM_TEMPLATE_PATH=/deploy/keycloak/realm-template.json

# ── OpenBao (per-tenant IdP secrets + Keycloak admin credential, §10.2) ──
# Host port 8210, not OpenBao/Vault's default 8200 — avoids colliding with
# a developer's own locally-running Vault/OpenBao instance (`docker-up`'s
# openbao service maps container port 8200 -> host 8210; see the comment
# above that service block in docker-compose.yml for what it does and does
# not exercise).
BAO_ADDR=http://localhost:8210
BAO_AUTH_ROLE=iam-realm-provisioner
BAO_KV_MOUNT=secret
BAO_IDP_PATH_PREFIX=iam/realm-provisioner/idp
BAO_KEYCLOAK_ADMIN_PATH=iam/realm-provisioner/keycloak-admin

# ── Org & Membership (I-8 residual-MFA check, I-16 subscription-lapse poll) ─
ORG_MEMBERSHIP_BASE_URL=http://localhost:8082
ORG_MEMBERSHIP_TIMEOUT_MS=5s

# ── Token Service (§2.5 — TS-1/TS-4 mint/rotate handshake, RP-17/RP-18) ──
# No mock yet in ../mock-servers as of this writing — run a real
# iam-token-service instance locally on this port, or point at one.
TOKEN_SERVICE_BASE_URL=http://localhost:8083

# ── Audit Log (§10.6 — AL-5 direct-write for TenantIdpConfigChanged) ────
# Optional: unset disables delivery (startup WARN) and entries accumulate
# in pending_audit_entries until it is set — nothing is lost.
AUDIT_LOG_BASE_URL=
AUDIT_DELIVERY_INTERVAL=5s
AUDIT_DELIVERY_BATCH_SIZE=50

# ── Realm export (offboarding, §15.2) ────────────────────────────────────
REALM_EXPORT_BUCKET=iam-realm-exports
REALM_EXPORT_KMS_KEY=

# ── Lifecycle timers (§8.7-8.9) ───────────────────────────────────────────
TRIAL_GRACE_DAYS=30
CANCELLED_GRACE_DAYS=30
RETENTION_DAYS=90
RECONCILER_BATCH_LIMIT=100
RECONCILER_TIMEOUT=5m
# RP-C4 poison-pill cap (§8.10): a realm_config_reconciliations row moves to
# the terminal 'failed' status once it has been retried this many times,
# instead of staying 'pending' (and consuming a ListPending batch slot)
# forever.
RECONCILER_MAX_ATTEMPTS=20
# orphaned-signup-reap (§8.7): a shared-realm signup that never received
# O&M's TrialStarted is reaped once older than this (Go duration, floor 1h;
# an invalid value aborts that job).
ORPHAN_SIGNUP_AFTER=48h
# Idempotency ledger in_progress lease (must exceed CONVERT_TIMEOUT) and the
# detached RP-3 conversion budget.
IDEMPOTENCY_IN_PROGRESS_LEASE=15m
CONVERT_TIMEOUT=10m

# ── Docs ──────────────────────────────────────────────────────────────────
DOCS_ENABLED=true
DOCS_AUTH_TOKEN=

# ── Tracing (platform-gincommon InitTracingWithConfig) ────────────────────
# The provider is always installed, so trace IDs work either way. The service
# name is APP_NAME (above); OTEL_SERVICE_NAME is not read. An UNSET endpoint is
# not "off": it falls back to localhost:4317 and logs a failed export on every
# flush, so local runs without a collector use "none" (OTEL_TRACES_EXPORTER=none
# works too). Point it at a collector (e.g. localhost:4317) to export.
OTEL_EXPORTER_OTLP_ENDPOINT=none
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_RATIO=1.0
OTEL_PROPAGATOR_BAGGAGE=false
OTEL_TRACES_IGNORE_REMOTE_PARENT_SAMPLED=false

# ── Test parallelism (make test/test-ci/test-postgres/test-integration) ──
# Makefile defaults (4 / 2) are deliberately conservative for a shared CI
# runner; on a beefier local box these are worth raising. Measured on a
# 10-core / 7.75GB-Docker-memory dev machine (37 postgres test funcs, 16
# integration test funcs, each spinning its own container):
#   TEST_POSTGRES_PARALLEL:    4 -> 22.1s, 10 -> 17.8s (~20% faster, safe —
#     each Postgres container is lightweight; CPU sat at 24-30%, still
#     nowhere near saturated even at 10).
#   TEST_INTEGRATION_PARALLEL: 2 -> 118.0s, 3 -> 121.3s (NO improvement —
#     Keycloak's JVM/Quarkus boot time dominates wall-clock regardless of
#     Go-level test parallelism, so raising this only adds Docker memory
#     pressure for no speedup; leave at the default unless you've measured
#     otherwise on your own box). Never raise it uncapped (GOMAXPROCS) on
#     any machine with <16GB of Docker memory - OOM-kills containers.
# TEST_POSTGRES_PARALLEL=10
# TEST_INTEGRATION_PARALLEL=2

# ── Reconciler metrics (cmd/reconciler pushMetrics) ──────────────────────
# CronJobs have no /metrics listener; each run pushes here when set.
PROMETHEUS_PUSHGATEWAY_URL=

# ── Schema migrations ────────────────────────────────────────────────────
# Unset/true: the server migrates at startup (local dev). Kubernetes sets
# false on every replica — the migrate hook Job (cmd/migrate) owns it.
RUN_MIGRATIONS=true
